  (princ "\nASG-SETUP ---------------------------------------------")
  (asg:tablestyles)
  (asg:pagesetups)
  (asg:setvars)
  (c:ASG-QA)
  (princ "\nASG-SETUP complete. If FAIL = 0: SAVEAS DWG, then SAVEAS DWT.")
  (princ))

(princ "\nASG_Setup loaded: ASG-SETUP, ASG-QA, ASG-PROFILE (optional).")
(princ)
