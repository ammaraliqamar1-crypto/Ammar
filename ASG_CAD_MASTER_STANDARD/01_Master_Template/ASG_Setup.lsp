(defun c:ASG-PROFILE (/ r)
  (initget "Yes No")
  (if (= (getkword "\nChange YOUR AutoCAD profile (registry) settings to ASG defaults? [Yes/No] <No>: ") "Yes")
    (progn
      (foreach p '(("OSMODE" . 2223) ("AUTOSNAP" . 63) ("POLARANG" . 45.0) ("ORTHOMODE" . 0) ("DYNMODE" . 3) ("DYNPROMPT" . 1) ("SELECTIONCYCLING" . 2) ("GRIPS" . 1) ("GRIPSIZE" . 5) ("PICKBOX" . 4) ("APERTURE" . 8) ("PICKFIRST" . 1) ("PICKADD" . 2) ("ANNOAUTOSCALE" . 0) ("SAVETIME" . 10) ("ISAVEBAK" . 1) ("LAYOUTREGENCTL" . 2) ("REFPATHTYPE" . 1))
        (setq r (vl-catch-all-apply 'setvar (list (car p) (cdr p))))
        (princ (strcat "\n  " (car p) (if (vl-catch-all-error-p r) " not set" " set"))))
      (princ "\nASG profile settings applied."))
    (princ "\nNo changes made."))
  (princ))

