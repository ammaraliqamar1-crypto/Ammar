(defun asg:setvars (/ r)
  (foreach p '(("CANNOSCALE" . "1:1") ("MSLTSCALE" . 1) ("ANNOALLVISIBLE" . 0) ("CMLEADERSTYLE" . "ASG-ML-ANNO") ("CTABLESTYLE" . "ASG-TABLE-STANDARD") ("HPLAYER" . "ASG-HATCH") ("DIMLAYER" . "ASG-DIMENSION") ("UCSFOLLOW" . 0))
    (setq r (vl-catch-all-apply 'setvar (list (car p) (cdr p))))
    (princ (strcat "\n  " (car p) (if (vl-catch-all-error-p r) " NOT SET (not supported in this release)" " set"))))
  (princ))

